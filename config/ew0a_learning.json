{
  "auto_assess_readiness": true,
  "auto_extract_after": [
    "VERIFIED",
    "REPAIR",
    "ESCALATE",
    "POLICY_VIOLATION",
    "ABSTAIN",
    "HUMAN_DECISION"
  ],
  "automatic_authority_change": false,
  "automatic_certification": false,
  "competence_update_after_outcome": true,
  "enabled": true,
  "recent_window_size": 20,
  "require_evidence": true,
  "retrieval": {
    "enabled": true,
    "match_capability": true,
    "match_failure_class": true,
    "match_risk_domain": true,
    "match_subsystem": true,
    "match_task_class": true,
    "max_lessons": 5,
    "recency_weight": 0.15
  },
  "schema_kind": "experimental_noncanonical",
  "schema_version": "engineering.learning_config.v0",
  "semantic_lesson_validation": "independent_gpt",
  "thresholds": {
    "high_risk_consecutive_safe_multiplier": 2.0,
    "high_risk_minimum_success_rate": 0.95,
    "high_risk_observation_multiplier": 2.0,
    "max_authority_violations": 0,
    "max_false_certifications": 0,
    "max_missed_e4_escalations": 0,
    "max_security_escalation_failures": 0,
    "minimum_consecutive_safe": 10,
    "minimum_lesson_transfer_rate": 0.8,
    "minimum_observations": 20,
    "minimum_success_rate": 0.9
  },
  "track_unsafe_separately": true,
  "trusted_actors": [
    "claude_code",
    "trusted_controller",
    "ew0a-certification"
  ]
}
